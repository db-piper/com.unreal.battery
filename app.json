        "titleFormatted": {
          "en": "Update Unreal Battery with [[soh]], [[soc]], [[temp]], [[power]] every [[time_base]] seconds"
        },
        "hint": {
          "en": "Update battery capabilities by computing energy from power and time interval"
        },
        "args": [
          {
            "type": "device",
